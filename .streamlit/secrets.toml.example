# Copy to secrets.toml for local cloud testing, or paste these keys in
# Streamlit Community Cloud → App → Settings → Secrets.

XAI_API_KEY = "your-xai-key"
XAI_TEXT_MODEL = "grok-3"
XAI_VISION_MODEL = "grok-4"

CHROMA_DB_PATH = "./medlabel_db"
CHROMA_COLLECTION = "medlabel_chunks"

# Optional: URL to medlabel_db.tar.gz (GitHub release asset) if DB is not in the repo.
# MEDLABEL_DB_TAR_URL = "https://github.com/org/MedLabel/releases/download/v1.0/medlabel_db.tar.gz"
