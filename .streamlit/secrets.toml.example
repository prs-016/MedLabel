# Paste these into Streamlit Community Cloud → App settings → Secrets.
# Fill in your actual keys — never commit the real values to git.

GEMINI_API_KEY = "your_gemini_key_here"
XAI_API_KEY = "your_xai_key_here"
XAI_TEXT_MODEL = "grok-3"
XAI_VISION_MODEL = "grok-4"
ROBOFLOW_API_KEY = "your_roboflow_key_here"
CHROMA_DB_PATH = "./medlabel_db"
CHROMA_COLLECTION = "medlabel_chunks"

# Optional: URL to medlabel_db.tar.gz if DB is not in the repo.
# MEDLABEL_DB_TAR_URL = "https://github.com/org/MedLabel/releases/download/v1.0/medlabel_db.tar.gz"
