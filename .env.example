# xAI API (vision + agent + flat-label structuring)
# Use XAI_API_KEY or xai_api_key in .env
XAI_API_KEY=your_xai_api_key_here
# Optional models (defaults: grok-3 text, grok-4 vision)
# XAI_MODEL_TEXT=grok-3
# XAI_MODEL_VISION=grok-4
# XAI_API_BASE=https://api.x.ai/v1

# Roboflow — API key is enough if you only have one project; otherwise set PROJECT or URL
ROBOFLOW_API_KEY=your_roboflow_api_key_here
# ROBOFLOW_PROJECT=flat-cylindrical
# ROBOFLOW_PROJECT_URL=https://app.roboflow.com/your-workspace/your-project
# ROBOFLOW_VERSION=1

# openFDA (optional — increases rate limit from 1K to 120K requests/day)
OPENFDA_API_KEY=your_openfda_key_here

# ChromaDB
CHROMA_DB_PATH=./medlabel_db
