# Google Gemini API
GEMINI_API_KEY= your_gemini_key

# openFDA (optional — increases rate limit from 1K to 120K requests/day)
OPENFDA_API_KEY=your_openfda_api_key_here

# xAI (OCR + chat answers)
XAI_API_KEY=your_xai_key
XAI_TEXT_MODEL=grok-3
XAI_VISION_MODEL=grok-4

# ChromaDB (Akshay JSON ingest → medlabel_db)
CHROMA_DB_PATH=./medlabel_db
CHROMA_COLLECTION=medlabel_chunks
